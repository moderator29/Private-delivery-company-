# SwiftTrack Private Delivery Company
# Copy to .env.local and fill in the values for your Supabase project.
# .env.local is gitignored. Never commit real keys.

# --- Required -------------------------------------------------------------

# Supabase project API URL. Dashboard > Project Settings > Data API.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Publishable key (sb_publishable_...). Safe to expose in the browser: every
# request it makes is still subject to Row Level Security.
# Do NOT put the secret / service_role key here. Anything prefixed with
# NEXT_PUBLIC_ is compiled into the client bundle.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# Public origin of the deployment. Used for canonical URLs, the sitemap and
# copy-tracking-link actions. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Optional -------------------------------------------------------------

# Service role key. The application does NOT need this: the contact form writes
# through a constrained database function instead. It is only used by the
# optional scripts/create-admin.mjs bootstrap helper. If you set it, keep it
# server-side only and never prefix it with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=""

# Local Chromium path for Playwright, when the browser is preinstalled rather
# than downloaded by `npx playwright install`.
# PLAYWRIGHT_CHROMIUM_PATH="/opt/pw-browsers/chromium/chrome-linux/chrome"
